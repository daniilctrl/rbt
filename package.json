{
  "name": "nest-rabbit-telegram",
  "version": "0.1.0",
  "private": true,
  "description": "Микросервисная архитектура на Nest.js: Producer + Consumer (RabbitMQ) + Telegram-notifier",
  "scripts": {
    "build": "pnpm -r build",
    "build:contracts": "pnpm --filter @app/contracts build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "start:producer": "pnpm build:contracts && pnpm --filter producer start:dev",
    "start:consumer": "pnpm build:contracts && pnpm --filter consumer start:dev",
    "start:telegram": "pnpm build:contracts && pnpm --filter telegram-notifier start:dev",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.5"
}
