# ============================================
# RabbitMQ
# ============================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Имена топологии (можно не трогать)
EVENTS_EXCHANGE=events.exchange
EVENTS_QUEUE=events.q
EVENTS_RETRY_QUEUE=events.retry.q
EVENTS_DLX=events.dlx
EVENTS_DLQ=events.dlq.parking

NOTIFICATIONS_EXCHANGE=notifications.exchange
NOTIFICATIONS_TELEGRAM_QUEUE=notifications.telegram.q
NOTIFICATIONS_RETRY_QUEUE=notifications.retry.q
NOTIFICATIONS_DLX=notifications.dlx
NOTIFICATIONS_DLQ=notifications.dlq.parking

# Сколько раз ретраить перед отправкой в DLQ parking
RETRY_MAX_ATTEMPTS=3
RETRY_TTL_MS=2000

# ============================================
# Redis (идемпотентность consumer'а)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
IDEMPOTENCY_TTL_SECONDS=86400

# ============================================
# HTTP-порты
# ============================================
PRODUCER_PORT=3000
CONSUMER_PORT=3001
TELEGRAM_NOTIFIER_PORT=3002

# ============================================
# Telegram Bot API
# ============================================
# Получить через @BotFather (/newbot), затем chat_id через
# https://api.telegram.org/bot<TOKEN>/getUpdates после написания боту /start
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here
TELEGRAM_API_BASE=https://api.telegram.org

# Логирование
LOG_LEVEL=info
